GEMINI_API_KEY=your_gemini_api_key_here

# 必須（ランキングを使う場合）。どちらか一方があれば動く。両方あれば REST を優先する。
# 未設定だと /api/rank が 503 kv_not_configured を返し、ランキング画面に何も出ない。
#
# (A) TCP 接続文字列。Vercel Marketplace の「Redis」(Redis Cloud) はこれを注入する。
# REDIS_URL=rediss://default:xxxx@xxxx.redis-cloud.com:6379
#
# (B) REST エンドポイント。Upstash / Vercel KV を使う場合。
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=your_upstash_rest_token
# Upstash の変数名でも可（KV_ 系が優先される）
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 任意（合言葉方式を使う場合）。設定するとフロントは x-event-pass ヘッダの送出が必要になる。
# EVENT_PASS=mochica0722

# 運営用の合言葉。/?admin=1 の「記録を全消去」で x-admin-token として要求される。
# 未設定（ADMIN_TOKEN も EVENT_PASS も無い）の場合、消去は 403 で拒否される。
# ADMIN_TOKEN=your_admin_token

# 任意（/api/chat のタイムアウト・再試行の調整。未設定なら既定値）
# 1回の Gemini 呼び出しの上限（ms）
# GEMINI_ATTEMPT_TIMEOUT_MS=12000
# 再試行を含む総時間の上限（ms）。フロントの30秒より内側にすること
# GEMINI_TOTAL_TIMEOUT_MS=26000
# 再試行回数（0で再試行なし。初回 + この回数）
# GEMINI_MAX_RETRIES=2
