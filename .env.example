GEMINI_API_KEY=your_gemini_api_key_here

# 任意（合言葉方式を使う場合）。設定するとフロントは x-event-pass ヘッダの送出が必要になる。
# EVENT_PASS=mochica0722

# 任意（/api/chat のタイムアウト・再試行の調整。未設定なら既定値）
# 1回の Gemini 呼び出しの上限（ms）
# GEMINI_ATTEMPT_TIMEOUT_MS=12000
# 再試行を含む総時間の上限（ms）。フロントの30秒より内側にすること
# GEMINI_TOTAL_TIMEOUT_MS=26000
# 再試行回数（0で再試行なし。初回 + この回数）
# GEMINI_MAX_RETRIES=2
